{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Land under each commodity class, excluding grazing animals (hectares)",
    "anchor": "start",
    "font": "Fraunces",
    "fontSize": 15
  },
  "data": {
    "url": "data/landuse_classes.json"
  },
  "transform": [
    {
      "filter": "datum['class']!='Animals'"
    }
  ],
  "width": "container",
  "height": 260,
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#2e9e6b"
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 11
      },
      "encoding": {
        "text": {
          "field": "hectares",
          "format": ",.0f"
        }
      }
    }
  ],
  "encoding": {
    "y": {
      "field": "class",
      "sort": "-x",
      "title": null
    },
    "x": {
      "field": "hectares",
      "type": "quantitative",
      "axis": {
        "format": "~s"
      },
      "title": "Hectares"
    }
  },
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": false,
      "domain": false
    },
    "axisY": {
      "minExtent": 170
    }
  }
}